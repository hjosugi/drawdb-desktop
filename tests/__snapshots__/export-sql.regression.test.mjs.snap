"-- Generated by drawDB Desktop (MySQL Enhanced)
-- Diagram: Regression
-- Generated: 2024-01-02T03:04:05.000Z
SET FOREIGN_KEY_CHECKS=0;

CREATE TABLE \`customers\` (
  \`id\` SMALLINT NOT NULL AUTO_INCREMENT,
  \`code\` CHAR(8) NOT NULL UNIQUE,
  \`display_name\` VARCHAR(5000) DEFAULT 'O''Brien' COMMENT 'Shown "as is"',
  \`bio\` TINYTEXT,
  \`avatar\` TINYBLOB,
  \`hash\` BINARY(32),
  \`score\` DOUBLE DEFAULT -1.5,
  \`ratio\` FLOAT,
  \`born_at\` DATETIME,
  \`alarm\` TIME,
  \`flag\` BIT DEFAULT false,
  \`last_seen\` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  \`legacy_id\` INT(11) DEFAULT NULL,
  \`tier\` ENUM('gold','silver','it''s') DEFAULT 'silver',
  \`role\` ENUM('admin','member') NOT NULL,
  \`doc\` VARCHAR(255),
  \`balance\` DECIMAL(10,0),
  \`since\` YEAR,
  PRIMARY KEY (\`id\`),
  KEY \`idx_customers_name_born\` (\`display_name\`, \`born_at\`),
  UNIQUE KEY \`uq_customers_hash\` (\`hash\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='Customer''s master';

CREATE TABLE \`invoices_with_a_rather_long_table_name\` (
  \`id\` INTEGER NOT NULL AUTO_INCREMENT,
  \`customer_id\` SMALLINT NOT NULL,
  \`customer_code\` CHAR(8),
  \`total\` NUMERIC(14,4) CHECK (total >= 0),
  \`state\` VARCHAR(20) DEFAULT 'draft',
  PRIMARY KEY (\`id\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE \`invoice_lines\` (
  \`invoice_id\` INTEGER NOT NULL,
  \`line_no\` INT NOT NULL,
  \`note\` TEXT COMMENT 'free text',
  PRIMARY KEY (\`invoice_id\`, \`line_no\`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

ALTER TABLE \`invoices_with_a_rather_long_table_name\` ADD CONSTRAINT \`fk_invoices_with_a_rather_long_table_name_customers_1\` FOREIGN KEY (\`customer_id\`) REFERENCES \`customers\` (\`id\`) ON DELETE SET NULL ON UPDATE RESTRICT;
ALTER TABLE \`invoices_with_a_rather_long_table_name\` ADD CONSTRAINT \`fk_invoice_customer_code\` FOREIGN KEY (\`customer_code\`) REFERENCES \`customers\` (\`code\`) ON UPDATE CASCADE;
ALTER TABLE \`invoice_lines\` ADD CONSTRAINT \`fk_invoice_lines_invoices_with_a_rather_long_table_name_3\` FOREIGN KEY (\`invoice_id\`) REFERENCES \`invoices_with_a_rather_long_table_name\` (\`id\`) ON DELETE CASCADE;

SET FOREIGN_KEY_CHECKS=1;"
`;

