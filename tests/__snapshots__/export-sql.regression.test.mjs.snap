"-- Generated by drawDB Desktop (Oracle dialect)
-- Diagram: Regression
-- Generated: 2024-01-02T03:04:05.000Z

CREATE OR REPLACE TYPE "money_type" AS OBJECT (
  "amount" NUMBER(10,2),
  "currency" CHAR(3)
);
/
CREATE TABLE "customers" (
  "id" NUMBER(5) GENERATED BY DEFAULT AS IDENTITY NOT NULL,
  "code" CHAR(8) NOT NULL UNIQUE,
  "display_name" VARCHAR2(4000) DEFAULT 'O''Brien',
  "bio" VARCHAR2(255),
  "avatar" RAW(255),
  "hash" RAW(32),
  "score" BINARY_DOUBLE DEFAULT -1.5,
  "ratio" BINARY_FLOAT,
  "born_at" TIMESTAMP,
  "alarm" TIMESTAMP,
  "flag" NUMBER(1) DEFAULT 0,
  "last_seen" TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  "legacy_id" NUMBER(10) DEFAULT NULL,
  "tier" VARCHAR2(10) DEFAULT 'silver',
  "role" VARCHAR2(10) NOT NULL,
  "doc" JSONB,
  "balance" NUMBER(10,0),
  "since" YEAR,
  CONSTRAINT "pk_customers" PRIMARY KEY ("id"),
  CONSTRAINT "chk_customers_tier_enum" CHECK ("tier" IN ('gold','silver','it''s')),
  CONSTRAINT "chk_customers_role_enum" CHECK ("role" IN ('admin','member'))
);
COMMENT ON TABLE "customers" IS 'Customer''s master';
COMMENT ON COLUMN "customers"."display_name" IS 'Shown "as is"';
CREATE INDEX "idx_customers_name_born" ON "customers" ("display_name", "born_at");
CREATE UNIQUE INDEX "uq_customers_hash" ON "customers" ("hash");

CREATE TABLE "invoices_with_a_rather_long_table_name" (
  "id" NUMBER(10) GENERATED BY DEFAULT AS IDENTITY NOT NULL,
  "customer_id" NUMBER(5) NOT NULL,
  "customer_code" CHAR(8),
  "total" NUMBER(14,4),
  "state" VARCHAR2(20) DEFAULT 'draft',
  CONSTRAINT "pk_invoices_with_a_rather_long_table_name" PRIMARY KEY ("id"),
  CONSTRAINT "chk_invoices_with_a_rather_long_table_name_total" CHECK (total >= 0)
);

CREATE TABLE "invoice_lines" (
  "invoice_id" NUMBER(10) NOT NULL,
  "line_no" NUMBER(10) NOT NULL,
  "note" CLOB,
  CONSTRAINT "pk_invoice_lines" PRIMARY KEY ("invoice_id", "line_no")
);
COMMENT ON COLUMN "invoice_lines"."note" IS 'free text';

ALTER TABLE "invoices_with_a_rather_long_table_name" ADD CONSTRAINT "fk_invoices_with_a_rather_long" FOREIGN KEY ("customer_id") REFERENCES "customers" ("id") ON DELETE SET NULL;
ALTER TABLE "invoices_with_a_rather_long_table_name" ADD CONSTRAINT "fk_invoice_customer_code" FOREIGN KEY ("customer_code") REFERENCES "customers" ("code");
ALTER TABLE "invoice_lines" ADD CONSTRAINT "fk_invoice_lines_invoices_with" FOREIGN KEY ("invoice_id") REFERENCES "invoices_with_a_rather_long_table_name" ("id") ON DELETE CASCADE;"
`;

