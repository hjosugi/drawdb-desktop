"-- Generated by drawDB Desktop (PostgreSQL dialect)
-- Diagram: Regression
-- Generated: 2024-01-02T03:04:05.000Z

CREATE TYPE "money_type" AS (
  "amount" NUMERIC(10,2),
  "currency" CHAR(3)
);
CREATE TYPE "role" AS ENUM ('admin', 'member');
CREATE TYPE "customers_tier" AS ENUM ('gold', 'silver', 'it''s');

CREATE TABLE "customers" (
  "id" SMALLSERIAL,
  "code" CHAR(8) NOT NULL UNIQUE,
  "display_name" VARCHAR(5000) DEFAULT 'O''Brien',
  "bio" VARCHAR(255),
  "avatar" BYTEA,
  "hash" BYTEA,
  "score" DOUBLE PRECISION DEFAULT -1.5,
  "ratio" REAL,
  "born_at" TIMESTAMP,
  "alarm" TIME,
  "flag" BOOLEAN DEFAULT false,
  "last_seen" TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  "legacy_id" INTEGER DEFAULT NULL,
  "tier" "customers_tier" DEFAULT 'silver',
  "role" "role" NOT NULL,
  "doc" JSONB,
  "balance" NUMERIC,
  "since" SMALLINT,
  CONSTRAINT "pk_customers" PRIMARY KEY ("id")
);
COMMENT ON TABLE "customers" IS 'Customer''s master';
COMMENT ON COLUMN "customers"."display_name" IS 'Shown "as is"';
CREATE INDEX "idx_customers_name_born" ON "customers" ("display_name", "born_at");
CREATE UNIQUE INDEX "uq_customers_hash" ON "customers" ("hash");

CREATE TABLE "invoices_with_a_rather_long_table_name" (
  "id" SERIAL,
  "customer_id" SMALLINT NOT NULL,
  "customer_code" CHAR(8),
  "total" NUMERIC(14,4),
  "state" VARCHAR(20) DEFAULT 'draft',
  CONSTRAINT "pk_invoices_with_a_rather_long_table_name" PRIMARY KEY ("id"),
  CONSTRAINT "chk_invoices_with_a_rather_long_table_name_total" CHECK (total >= 0)
);

CREATE TABLE "invoice_lines" (
  "invoice_id" INTEGER NOT NULL,
  "line_no" INTEGER NOT NULL,
  "note" TEXT,
  CONSTRAINT "pk_invoice_lines" PRIMARY KEY ("invoice_id", "line_no")
);
COMMENT ON COLUMN "invoice_lines"."note" IS 'free text';

ALTER TABLE "invoices_with_a_rather_long_table_name" ADD CONSTRAINT "fk_invoices_with_a_rather_long_table_name_customers_1" FOREIGN KEY ("customer_id") REFERENCES "customers" ("id") ON DELETE SET NULL ON UPDATE RESTRICT;
ALTER TABLE "invoices_with_a_rather_long_table_name" ADD CONSTRAINT "fk_invoice_customer_code" FOREIGN KEY ("customer_code") REFERENCES "customers" ("code") ON UPDATE CASCADE;
ALTER TABLE "invoice_lines" ADD CONSTRAINT "fk_invoice_lines_invoices_with_a_rather_long_table_name_3" FOREIGN KEY ("invoice_id") REFERENCES "invoices_with_a_rather_long_table_name" ("id") ON DELETE CASCADE;"
`;

exports[`SQL exporter regression goldens > keeps SQL Server output byte-identical 1`] = `
"-- Generated by drawDB Desktop (SQL Server (T-SQL) dialect)
-- Diagram: Regression
-- Generated: 2024-01-02T03:04:05.000Z

CREATE TABLE [customers] (
  [id] SMALLINT IDENTITY(1,1) NOT NULL,
  [code] NCHAR(8) NOT NULL UNIQUE,
  [display_name] NVARCHAR(MAX) DEFAULT N'O''Brien',
  [bio] NVARCHAR(255),
  [avatar] VARBINARY(255),
  [hash] BINARY(32),
  [score] FLOAT DEFAULT -1.5,
  [ratio] REAL,
  [born_at] DATETIME2,
  [alarm] TIME,
  [flag] BIT DEFAULT 0,
  [last_seen] DATETIME2 DEFAULT CURRENT_TIMESTAMP,
  [legacy_id] INT DEFAULT NULL,
  [tier] NVARCHAR(10) DEFAULT N'silver',
  [role] NVARCHAR(10) NOT NULL,
  [doc] NVARCHAR(MAX),
  [balance] DECIMAL(18,0),
  [since] SMALLINT,
  CONSTRAINT [PK_customers] PRIMARY KEY ([id]),
  CONSTRAINT [CK_customers_tier_enum] CHECK ([tier] IN (N'gold', N'silver', N'it''s')),
  CONSTRAINT [CK_customers_role_enum] CHECK ([role] IN (N'admin', N'member'))
);
EXEC sp_addextendedproperty
  @name = N'MS_Description', @value = N'Customer''s master',
  @level0type = N'SCHEMA', @level0name = N'dbo',
  @level1type = N'TABLE', @level1name = N'customers';
EXEC sp_addextendedproperty
  @name = N'MS_Description', @value = N'Shown "as is"',
  @level0type = N'SCHEMA', @level0name = N'dbo',
  @level1type = N'TABLE', @level1name = N'customers',
  @level2type = N'COLUMN', @level2name = N'display_name';
CREATE INDEX [idx_customers_name_born] ON [customers] ([display_name], [born_at]);
CREATE UNIQUE INDEX [uq_customers_hash] ON [customers] ([hash]);

CREATE TABLE [invoices_with_a_rather_long_table_name] (
  [id] INT IDENTITY(1,1) NOT NULL,
  [customer_id] SMALLINT NOT NULL,
  [customer_code] NCHAR(8),
  [total] DECIMAL(14,4),
  [state] NVARCHAR(20) DEFAULT N'draft',
  CONSTRAINT [PK_invoices_with_a_rather_long_table_name] PRIMARY KEY ([id]),
  CONSTRAINT [CK_invoices_with_a_rather_long_table_name_total] CHECK (total >= 0)
);

CREATE TABLE [invoice_lines] (
  [invoice_id] INT NOT NULL,
  [line_no] INT NOT NULL,
  [note] NVARCHAR(MAX),
  CONSTRAINT [PK_invoice_lines] PRIMARY KEY ([invoice_id], [line_no])
);
EXEC sp_addextendedproperty
  @name = N'MS_Description', @value = N'free text',
  @level0type = N'SCHEMA', @level0name = N'dbo',
  @level1type = N'TABLE', @level1name = N'invoice_lines',
  @level2type = N'COLUMN', @level2name = N'note';

ALTER TABLE [invoices_with_a_rather_long_table_name] ADD CONSTRAINT [FK_invoices_with_a_rather_long_table_name_customers_1] FOREIGN KEY ([customer_id]) REFERENCES [customers] ([id]) ON DELETE SET NULL;
ALTER TABLE [invoices_with_a_rather_long_table_name] ADD CONSTRAINT [fk_invoice_customer_code] FOREIGN KEY ([customer_code]) REFERENCES [customers] ([code]) ON UPDATE CASCADE;
ALTER TABLE [invoice_lines] ADD CONSTRAINT [FK_invoice_lines_invoices_with_a_rather_long_table_name_3] FOREIGN KEY ([invoice_id]) REFERENCES [invoices_with_a_rather_long_table_name] ([id]) ON DELETE CASCADE;"
`;
