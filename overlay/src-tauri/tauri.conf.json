{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drawDB",
  "version": "1.7.0",
  "identifier": "app.drawdb.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "drawDB",
        "width": 1366,
        "height": 850,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost asset: https://asset.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage",
      "dmg"
    ],
    "category": "DeveloperTool",
    "license": "AGPL-3.0",
    "shortDescription": "Database schema editor",
    "longDescription": "drawDB - Free and simple database diagram editor and SQL generator",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ddb"
        ],
        "name": "drawDB Diagram",
        "description": "drawDB diagram file",
        "role": "Editor",
        "mimeType": "application/x-drawdb"
      },
      {
        "ext": [
          "ddbpack"
        ],
        "name": "drawDB Project Pack",
        "description": "drawDB project package",
        "role": "Editor",
        "mimeType": "application/x-drawdbpack"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "wix": {
        "language": [
          "en-US",
          "ja-JP"
        ]
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-drawdb.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-drawdbpack.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-drawdb.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-drawdbpack.png": "icons/128x128.png",
          "/usr/share/metainfo/app.drawdb.desktop.metainfo.xml": "linux/app.drawdb.desktop.metainfo.xml",
          "/usr/share/mime/packages/app.drawdb.desktop.xml": "linux/app.drawdb.desktop.xml"
        }
      },
      "deb": {
        "desktopTemplate": "linux/drawdb.desktop.hbs",
        "files": {
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-drawdb.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-drawdbpack.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-drawdb.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-drawdbpack.png": "icons/128x128.png",
          "/usr/share/metainfo/app.drawdb.desktop.metainfo.xml": "linux/app.drawdb.desktop.metainfo.xml",
          "/usr/share/mime/packages/app.drawdb.desktop.xml": "linux/app.drawdb.desktop.xml"
        },
        "postInstallScript": "linux/update-desktop-mime-cache.sh",
        "postRemoveScript": "linux/update-desktop-mime-cache.sh"
      },
      "rpm": {
        "desktopTemplate": "linux/drawdb.desktop.hbs",
        "files": {
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-drawdb.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-x-drawdbpack.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-drawdb.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-x-drawdbpack.png": "icons/128x128.png",
          "/usr/share/metainfo/app.drawdb.desktop.metainfo.xml": "linux/app.drawdb.desktop.metainfo.xml",
          "/usr/share/mime/packages/app.drawdb.desktop.xml": "linux/app.drawdb.desktop.xml"
        },
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2"
        ],
        "postInstallScript": "linux/update-desktop-mime-cache.sh",
        "postRemoveScript": "linux/update-desktop-mime-cache.sh"
      }
    }
  }
}
