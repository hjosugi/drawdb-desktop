{
  "name": "drawdb-desktop-overlay",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "Desktop overlay for drawDB-App: .ddb/.ddbpack file storage, Excel I/O, and Oracle/MySQL/PostgreSQL SQL dialects for Tauri.",
  "license": "0BSD",
  "bin": {
    "drawdb": "./scripts/drawdb-cli.mjs"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:dry-run": "node scripts/setup.mjs --dry-run",
    "cli": "node scripts/drawdb-cli.mjs",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:config": "vitest run tests/config.test.mjs",
    "test:i18n": "vitest run tests/i18n.test.mjs",
    "test:sql": "vitest run tests/sql.test.mjs tests/import-sql.test.mjs tests/import-sql-common.test.mjs tests/export-sql.edge.test.mjs tests/export-sql.snap.test.mjs",
    "test:excel": "vitest run tests/excel.test.mjs",
    "icons": "python3 scripts/generate_icons.py"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "vitest": "^4.1.9"
  },
  "drawdbDesktopSetup": {
    "projectName": "drawDB-Desktop",
    "baseRepo": "https://github.com/khsuzan/drawDB-App.git",
    "npmPackages": [
      "jszip",
      "exceljs",
      "@tauri-apps/cli@2.11.4",
      "@tauri-apps/api@2.11.1",
      "@tauri-apps/plugin-fs@2.5.1",
      "@tauri-apps/plugin-dialog@2.7.1",
      "@tauri-apps/plugin-sql@2.4.0",
      "@tauri-apps/plugin-opener@2.5.4",
      "@tauri-apps/plugin-window-state@2.4.1"
    ],
    "cargoPackages": [
      {
        "name": "tauri-plugin-fs"
      },
      {
        "name": "tauri-plugin-dialog"
      },
      {
        "name": "tauri-plugin-single-instance"
      },
      {
        "name": "tauri-plugin-sql",
        "args": [
          "--features",
          "sqlite"
        ]
      },
      {
        "name": "tauri-plugin-opener"
      },
      {
        "name": "tauri-plugin-window-state"
      }
    ]
  }
}
